# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bright Data Scraper Studio (server-only)
BRIGHTDATA_API_KEY=
BRIGHTDATA_COLLECTOR_ID=c_mt4k8bvwaxtcnj8s8
BRIGHTDATA_DOCS_URL=https://stackwatch-demo.vercel.app/

# Snapshot persistence
# memory is a process-local development repository and is not durable.
# Use insforge after applying the migrations in migrations/.
SNAPSHOT_REPOSITORY=memory

# InsForge snapshot persistence (server-only; never use NEXT_PUBLIC_ for these values).
# Required when SNAPSHOT_REPOSITORY=insforge. The key must be a project admin key,
# because snapshot_records has row level security enabled with no policies.
INSFORGE_URL=
INSFORGE_API_KEY=

# Telegram notifications (server-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Gemini explanation (server-only; not enabled in this MVP build)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=
